# =====================   Clase Abstracta Base   ======================

class Entidad_Base(ABC):                               # clase abstracta que represente entidades generales del sistema
    @abstractmethod
    def mostrar_informacion(self):                     # Metodo que se debe implmentar en todas las clases que hereden de Entidad_Base
        pass

